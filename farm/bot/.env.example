# Copy this file to farm/bot/.env and fill it in. .env is gitignored: never commit it.

# From @BotFather in Telegram (/newbot). Required to run the bot, not for `preview`.
TELEGRAM_BOT_TOKEN=

# Chat IDs allowed to use the bot, comma-separated. Send /start to the bot to learn yours.
# Empty: anyone who finds the bot can use it (the bot warns at startup).
ALLOWED_CHAT_IDS=

# Daily message time (24-hour) and time zone.
DAILY_AT=09:00
TIMEZONE=America/Los_Angeles

# Data folder shared with the camera and sensor programs. Empty: farm/data.
CUTIEFARM_DATA=

# Optional: the command that runs a scan by hand, shown when no recent scan exists.
SCAN_COMMAND=

# Watering advice (a rule of thumb, see README). Setting FARM_LAT and FARM_LON turns on the
# Open-Meteo forecast and sends the location (rounded to 2 decimals, about 1 km) to Open-Meteo.
FARM_LAT=
FARM_LON=
WATER_BELOW_PCT=35
CITRUS_KC=0.65
HOLD_OFF_BELOW_MM=5
WEEKLY_FROM_MM=12
TWICE_WEEKLY_FROM_MM=25

# Optional: answer free-text questions with an OpenAI model (sends the question and a farm summary to OpenAI).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Optional: voice notes and audio files are sent to OpenAI for transcription.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# OpenAI calls per chat per day, and for the whole bot per day.
CHAT_DAILY_LIMIT=30
CHAT_GLOBAL_DAILY_LIMIT=500
